# ---------- Lokale Entwicklung ----------
# Datenbank aus docker-compose.dev.yml (Port 5433)
DATABASE_URL="postgresql://eatme:eatme@localhost:5433/eatme?schema=public"

# Mindestens 32 Zeichen, z. B.: openssl rand -base64 48
AUTH_SECRET="bitte-durch-einen-langen-zufaelligen-wert-ersetzen"

# Admin-Konto, wird beim Seed angelegt (lokal: npm run db:seed)
ADMIN_EMAIL="admin@eatme.local"
ADMIN_PASSWORD="bitte-aendern"

# ---------- Zusaetzlich fuer die Produktion (docker-compose.yml) ----------
# Domain, fuer die Caddy automatisch ein HTTPS-Zertifikat holt
DOMAIN="eatme.example.de"
ACME_EMAIL="admin@example.de"

POSTGRES_USER="eatme"
POSTGRES_PASSWORD="bitte-ein-sicheres-passwort"
POSTGRES_DB="eatme"

# Anzahl App-Container hinter Caddy
APP_REPLICAS=1
DATABASE_POOL_SIZE=10
BACKUP_KEEP_DAYS=14
