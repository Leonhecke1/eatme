{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# "app" loest ueber Docker-DNS auf alle Replikas auf, Caddy verteilt die Last.
	reverse_proxy {
		dynamic a app 3000 {
			refresh 10s
		}
		lb_policy round_robin
		lb_try_duration 5s
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}
